---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Astro Adda | Vedic Astrology Consultations">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden flex flex-col items-center text-center px-6">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-500/15 via-slate-950 to-slate-950"></div>
        <span class="px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-widest mb-6">
            ✨ Vedic Astrology & Cosmic Guidance
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight max-w-4xl text-white mb-6 leading-tight">
            Unlock Your Cosmic Blueprint with <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500">Astro Adda</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-400 max-w-2xl mb-10 leading-relaxed">
            Gain clarity on your Career, Marriage, Finances, and Health through precise Vedic Horoscope Reading, Kundali Analysis, and Proven Remedies.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a href="#contact" class="px-8 py-4 rounded-full bg-amber-500 text-slate-950 font-bold hover:bg-amber-400 transition flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20">
                Book My Reading <i data-lucide="arrow-right" class="w-5 h-5"></i>
            </a>
            <a href="#services" class="px-8 py-4 rounded-full bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-500/40 transition flex items-center justify-center gap-2 font-medium">
                Explore Services
            </a>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-24 max-w-7xl mx-auto px-6 border-t border-slate-800/80">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-amber-400 text-xs font-semibold uppercase tracking-widest">Our Offerings</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-4">Astrology Services Offered</h2>
            <p class="text-slate-400 text-sm">Choose from our wide range of personalized cosmic readings.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition group">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-6 group-hover:scale-110 transition">
                    <i data-lucide="file-text" class="w-6 h-6"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Kundali Reading</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">Comprehensive study of your birth chart to uncover strengths, weaknesses, and life trajectory.</p>
            </div>
            <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition group">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-6 group-hover:scale-110 transition">
                    <i data-lucide="heart" class="w-6 h-6"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Kundali Matching</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">Detailed compatibility analysis (Gun Milan, Ashtakoot) for marriage and long-term partnerships.</p>
            </div>
            <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition group">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-6 group-hover:scale-110 transition">
                    <i data-lucide="briefcase" class="w-6 h-6"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Career Astrology</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">Identify favorable timings for job changes, business investments, and financial growth periods.</p>
            </div>
        </div>
    </section>
    
    <!-- Contact & Booking Section -->
    <section id="contact" class="py-24 bg-slate-900/60 border-t border-slate-800">
        <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12">
            <div>
                <span class="text-amber-400 text-xs font-semibold uppercase tracking-widest">Connect With Us</span>
                <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-6">Book Your Appointment</h2>
                <p class="text-slate-400 text-sm leading-relaxed mb-8">
                    Fill out the form with your birth details, or reach out directly on WhatsApp.
                </p>
                <a href="https://wa.me/919876543210" target="_blank" class="flex items-center gap-4 p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-950/80 transition">
                    <i data-lucide="message-circle" class="w-6 h-6 shrink-0"></i>
                    <div>
                        <p class="font-semibold text-sm text-white">Chat Directly on WhatsApp</p>
                        <p class="text-xs text-emerald-400/80">+91 98765 43210</p>
                    </div>
                </a>
            </div>
            <form onsubmit="event.preventDefault(); alert('Booking submitted!');" class="p-8 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
                <h3 class="text-xl font-bold text-white mb-2">Request Consultation</h3>
                <input type="text" required placeholder="Full Name" class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-amber-500 outline-none">
                <input type="tel" required placeholder="Phone Number" class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-amber-500 outline-none">
                <input type="date" required class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-amber-500 outline-none">
                <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold hover:shadow-lg transition mt-2">
                    Submit Details & Book
                </button>
            </form>
        </div>
    </section>
</Layout>
